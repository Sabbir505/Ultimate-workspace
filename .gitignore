target/
node_modules/
dist/
dist-site/
*.log
.debug/
# Local OAuth client secrets for connectors (e.g. Notion). These are baked
# into the binary at build time via option_env! in src-tauri/src/connectors/
# config.rs — they must NEVER be committed (extractable from the binary, and
# a leaked secret lets an attacker impersonate your integration). Set the same
# vars in your shell when running the release build (see docs/ai-context/RELEASE.md).
src-tauri/.env
# Tauri updater signing keypair — the private key MUST stay local.
# If it leaks, anyone can ship signed updates to your users.
.tauri/relay-update.key
.tauri/relay-update.key.pub
# Staging channel: a SEPARATE keypair, so a staging artifact can never verify as
# a production update even if it somehow reached the production feed. Generated
# with `npx @tauri-apps/cli signer generate -w .tauri/relay-update-staging.key --ci`.
.tauri/relay-update-staging.key
.tauri/relay-update-staging.key.pub
# Bundled Python runtime (~70 MB of binaries) staged by
# scripts/fetch-bundled-python.mjs into the installer. Regenerated, not
# committed — never check in the python-build-standalone tree.
src-tauri/resources/python/

# Staged browser MCP sidecar binary for Tauri externalBin bundling.
# Generated by scripts/stage-browser-mcp.mjs from the Cargo build output.
src-tauri/binaries/

# Bundled LibreOffice for PPTX# Preview (fetched by scripts/fetch-bundled-libreoffice.mjs).
# 1.5 GB of binaries — regenerated at bundle time, never committed.
src-tauri/resources/libreoffice/

# Playwright MCP automation scratch output (screenshots/session artifacts).
.playwright-mcp/

# Local Netlify folder
.netlify

# Local automation captures, generated media, and machine-local scratch —
# never committed. (Files already tracked inside an ignored dir stay tracked;
# these only stop NEW scratch from showing up in git status.)
logs/
video/
Thesis Diagrams/
__pycache__/
.commandcode/
# Scratch dir (QA screenshots, patch probes, a live pairing token — never ship it)
Random Stuff/
.zcode/plans/
# Local image-generation outputs and one-off probe dumps
fox_uri.txt
src-tauri/fox_uri.txt
src-tauri/fox_err.txt
conduit_watch_probe.txt
registered_cmds.txt
scripts/__tmp_*
