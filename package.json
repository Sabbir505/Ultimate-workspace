{
  "name": "relay",
  "private": true,
  "version": "0.6.0",
  "description": "Relay — a local-first, multi-pane desktop shell for AI coding agents",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-pdfjs-wasm.mjs",
    "assets:pdfjs": "node scripts/copy-pdfjs-wasm.mjs",
    "dev": "node scripts/copy-pdfjs-wasm.mjs && vite",
    "build": "node scripts/copy-pdfjs-wasm.mjs && vite build && node -e \"const fs=require('fs');const dir='dist/assets';if(fs.existsSync(dir)){for(const f of fs.readdirSync(dir)){if(f.endsWith('.map'))fs.unlinkSync(dir+'/'+f)}}\"",
    "preview": "vite preview",
    "site:dev": "vite --config vite.site.config.ts",
    "site:build": "vite build --config vite.site.config.ts",
    "site:preview": "vite preview --config vite.site.config.ts",
    "tauri": "tauri",
    "stage:sidecars": "node scripts/stage-sidecar.mjs relay-browser-mcp && node scripts/stage-sidecar.mjs relay-automation",
    "test": "vitest run",
    "test:selfui": "node src-tauri/src/bridge_selfui.test.mjs",
    "test:e2e:desktop": "node e2e-desktop/run-e2e.mjs",
    "release:latest-json": "node scripts/make-latest-json.mjs",
    "tauri:build:staging": "tauri build --config src-tauri/tauri.staging.conf.json",
    "release:latest-json:staging": "node scripts/release-staging.mjs --latest-json-only",
    "release:staging": "node scripts/release-staging.mjs",
    "sync:releases": "node scripts/sync-releases-page.mjs"
  },
  "dependencies": {
    "@babel/standalone": "7.29.7",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@mermaid-js/layout-elk": "^0.2.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@types/dompurify": "^3.0.5",
    "@types/qrcode": "^1.5.6",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.14.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/xterm": "^5.5.0",
    "docx": "^9.7.1",
    "docx-preview": "^0.4.0",
    "dompurify": "^3.4.13",
    "html-to-image": "^1.11.13",
    "katex": "^0.18.1",
    "lucide-react": "^1.28.0",
    "mermaid": "^11.17.2",
    "pagedjs": "^0.4.3",
    "pdfjs-dist": "^6.3.289",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.0.1",
    "@types/babel__standalone": "^7.1.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.25",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
